{
  "entities": {
    "Vote": {
      "title": "Vote",
      "description": "Rekaman suara polling pemilihan Guru & Staf TU Favorit Hari Guru Nasional 2026 SMKS PGRI 1 Kota Sukabumi",
      "type": "object",
      "properties": {
        "namaSiswa": {
          "type": "string",
          "description": "Nama lengkap siswa pemilih",
          "maxLength": 100
        },
        "kelas": {
          "type": "string",
          "description": "Kelas dan jurusan siswa",
          "maxLength": 50
        },
        "namaGuru": {
          "type": "string",
          "description": "Nama guru favorit pilihan siswa",
          "maxLength": 100
        },
        "skorGuru": {
          "type": "object",
          "description": "Rincian skor 5 kriteria guru"
        },
        "rataRataGuru": {
          "type": "number",
          "description": "Rata-rata rating bintang guru"
        },
        "namaTU": {
          "type": "string",
          "description": "Nama staf Tata Usaha favorit pilihan siswa",
          "maxLength": 100
        },
        "skorTU": {
          "type": "object",
          "description": "Rincian skor 5 kriteria staf TU"
        },
        "rataRataTU": {
          "type": "number",
          "description": "Rata-rata rating bintang staf TU"
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu perekaman suara polling"
        }
      },
      "required": ["namaSiswa", "kelas", "namaGuru", "rataRataGuru", "namaTU", "rataRataTU", "createdAt"]
    },
    "MasterData": {
      "title": "MasterData",
      "description": "Daftar master siswa, guru, dan staf TU SMKS PGRI 1 Kota Sukabumi untuk dropdown polling",
      "type": "object",
      "properties": {
        "students": {
          "type": "array",
          "description": "Daftar siswa terdaftar per kelas"
        },
        "teachers": {
          "type": "array",
          "description": "Daftar guru favorit untuk pilihan dropdown"
        },
        "staff": {
          "type": "array",
          "description": "Daftar staf TU favorit untuk pilihan dropdown"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan data master terakhir"
        }
      },
      "required": ["students", "teachers", "staff"]
    }
  },
  "firestore": {
    "/votes/{voteId}": {
      "schema": "Vote",
      "description": "Koleksi dokumen polling suara siswa SMKS PGRI 1 Kota Sukabumi"
    },
    "/master_data/{docId}": {
      "schema": "MasterData",
      "description": "Konfigurasi daftar siswa, guru, dan staf TU untuk dropdown pilihan"
    }
  }
}
